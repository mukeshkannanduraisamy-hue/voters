# Copy to .env and fill in. Loaded automatically via `--env-file-if-exists`.

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# Must match server/.env's SYNC_API_KEY exactly. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_API_KEY=

PORT=4500
