{
  "name": "vms-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Voter Survey & Management System - REST API",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "import": "node scripts/import-data.mjs",
    "seed": "node scripts/seed.mjs",
    "reset": "node scripts/import-data.mjs --fresh && node scripts/seed.mjs",
    "test:api": "node scripts/test-api.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  }
}
