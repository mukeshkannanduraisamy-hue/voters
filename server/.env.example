# Copy to .env and fill in. Loaded automatically via `--env-file-if-exists`.

# --- Central MySQL (the app's primary database) ------------------------------
# REQUIRED — the server refuses to start (lib/env.js's requireEnv) if any of
# DB_HOST/DB_USER/DB_PASSWORD/DB_NAME is missing. There is no fallback.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Set to "false" to disable rejectUnauthorized:false TLS.
# DB_SSL=false

# --- Session / general --------------------------------------------------------
# REQUIRED — the server refuses to start if this is missing. There is no
# fallback secret.
VMS_JWT_SECRET=
# PORT=4000
# VMS_JWT_TTL_SECONDS=86400
# CRON_SECRET=
# Only consulted the very first time the database has zero A1 accounts at all
# (fresh deployment bootstrap). See README's "Admin bootstrap" note.
# BOOTSTRAP_ADMIN_MOBILE=9999999999

# --- Legacy: SQLite outbox -> sync-server (inert; see README) ----------------
# Nothing in index.js starts the sync worker that reads these — they only
# matter if you deliberately revive the legacy sync-server design.
SYNC_API_URL=
SYNC_API_KEY=
SYNC_BATCH_SIZE=100
SYNC_INTERVAL_MS=10000
SYNC_TIMEOUT_MS=15000
