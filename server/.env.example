# Copy to .env and fill in. Loaded automatically via `--env-file-if-exists`.

# --- Central MySQL sync (transactional outbox) ------------------------------
# Leave SYNC_API_URL blank to disable sync and run this instance purely local.
SYNC_API_URL=http://localhost:4500
SYNC_API_KEY=
SYNC_BATCH_SIZE=100
SYNC_INTERVAL_MS=10000
SYNC_TIMEOUT_MS=15000

# --- Session / general (optional overrides) ---------------------------------
# PORT=4000
# VMS_JWT_SECRET=
# VMS_JWT_TTL_SECONDS=86400
